# Copy to .env and fill in. Never commit .env or share it.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
# Optional. Defaults: smtp.zoho.com and 465. Try EMAIL_PORT=587 if 465 times out.
EMAIL_HOST=
EMAIL_PORT=

# Lenco SECRET key (Lenco dashboard > API keys). Used only on the server to
# confirm each payment before an order is saved. Without it, orders are
# saved as "paid-unverified" and you must check Lenco yourself.
LENCO_SECRET_KEY=
# Email Lenco uses for payment receipts (customers are not asked for one).
# If empty, EMAIL_TO is used.
LENCO_RECEIPT_EMAIL=
# Optional, for sandbox testing: https://sandbox.lenco.co/access/v2
LENCO_API_URL=

# Set to false if you do not accept cash on delivery (also change
# ENABLE_CASH_ON_DELIVERY in website/src/config.js).
ALLOW_CASH_ON_DELIVERY=false
